class Solution:
    def isEven (self, n):
        if n ^ (n-1) == 1:
            return False
        else:
            return True

7. Check if a number is power of two or not :
class Solution:
    def isPowerOfTwo(self, n: int) -> bool:
        if n & n-1 == 0 and n > 0:
            return True
        else:
            return False

8. Count number of set bits :
class Solution:
    def hammingWeight(self, n: int) -> int:
        count = 0
        while(n>0):
            n = n & (n-1)
            count += 1
        return count
